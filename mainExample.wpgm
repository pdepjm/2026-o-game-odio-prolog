import wollok.game.*

import nubes.*
import globo.*
import consumibles.*

// Cada Digito muestra una cifra del puntaje con una imagen (0.png ... 9.png en assets)
class Digito {
    const posicion
    const indice   // 0 = unidades, 1 = decenas, 2 = centenas, 3 = miles

    method position() = posicion
    method image() = "2026-o-game-odio-prolog/assets/" + self.valor().toString() + ".png"
    method valor() = globo.puntaje().div([1, 10, 100, 1000].get(indice)) % 10
}

object marcadorPuntaje {
    method mostrar() {
        game.addVisual(new Digito(posicion = game.at(0, 7), indice = 3))
        game.addVisual(new Digito(posicion = game.at(1, 7), indice = 2))
        game.addVisual(new Digito(posicion = game.at(2, 7), indice = 1))
        game.addVisual(new Digito(posicion = game.at(3, 7), indice = 0))
    }
}

object configuracionJuego {                        
        method iniciar() {                             
            game.clear()

            globo.reiniciar()
            game.addVisual(globo)
            marcadorPuntaje.mostrar()
            
            keyboard.left().whilePressedDo({ globo.direccionActual("izquierda") }, 50)
            keyboard.right().whilePressedDo({ globo.direccionActual("derecha") }, 50)
            
            game.onTick(350, "movimientoGlobo", {
                globo.moverseHorizontal()
                globo.avanzarAltura()
            })

            game.onTick(350, "movimientoNubes", {
                generadorDeNubes.moverNubes() 
                generadorDeConsumibles.moverConsumibles()
                })
            
            game.onCollideDo(globo, { elemento => elemento.interaccion() })
            
            generadorDeNubes.reiniciar()
            generadorDeConsumibles.reiniciar()
            game.onTick(200, "generadorNubes", { generadorDeNubes.generar() })
            game.onTick(1000, "generadorConsumibles", {generadorDeConsumibles.generar()})
            keyboard.r().onPressDo({ self.iniciar() })
        }                                              
    }

program PepitaGame {                               
        game.title("GloboMania")
        game.height(8)
        game.width(7)
        game.cellSize(250)
        game.boardGround("2026-o-game-odio-prolog/assets/cielo3.png")

        configuracionJuego.iniciar()
        game.start()
    }    

